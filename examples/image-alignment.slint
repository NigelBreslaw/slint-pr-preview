import { Palette } from "std-widgets.slint";
import { InspectorImageAlignment } from "../vendor/slint/tools/editor/ui/components/inspector/image-alignment.slint";
import { Colors, Typography } from "../vendor/slint/tools/editor/ui/style.slint";

export component Preview inherits Window {
    width: 320px;
    height: 240px;
    background: Colors.surface;
    default-font-family: Typography.family;
    in-out property <int> selected-column: 1;
    in-out property <int> selected-row: 1;
    init => { Palette.color-scheme = ColorScheme.light; }

    VerticalLayout {
        padding: 24px;
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            Text {
                text: "Image alignment";
                font-size: 14px;
                font-weight: 600;
                color: Colors.foreground;
            }
            Text {
                text: alignment.selected-label;
                font-size: 12px;
                color: Colors.muted;
                horizontal-alignment: right;
            }
        }
        alignment := InspectorImageAlignment {
            selected-column: root.selected-column;
            selected-row: root.selected-row;
            chosen(column, row) => {
                root.selected-column = column;
                root.selected-row = row;
            }
        }
    }
}
