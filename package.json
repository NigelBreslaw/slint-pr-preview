{
  "name": "slint-pr-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "playwright test",
    "test:config": "node --test scripts/preview-config.test.mjs scripts/shared-assets.test.mjs scripts/package.test.mjs",
    "verify:shared-cache": "node scripts/verify-shared-cache.mjs",
    "deploy": "wrangler deploy",
    "deploy:shared": "wrangler deploy --config wrangler.shared.jsonc"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "wrangler": "4.158.0"
  }
}
